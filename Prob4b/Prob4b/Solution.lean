import Prob4b.Theorems
import Prob4b.Proofs.StageA_Algebra.Basic
import Prob4b.Proofs.StageA_Algebra.NormalForm
import Prob4b.Proofs.StageB_Colon.Basic
import Prob4b.Proofs.StageB_Colon.TripleInter
import Prob4b.Proofs.StageB_Colon.ColonAssembly
import Prob4b.Proofs.StageC_Module.Basic
import Prob4b.Proofs.StageD_Idealization.Basic
import Prob4b.Proofs.StageE_Amplify.Basic
import Prob4b.Proofs.StageF_Headline.Basic

/-!
# The 20 frozen statements, re-exposed under clean names

Each of the 20 frozen statements of `Prob4b/Theorems.lean` is restated verbatim
in `namespace Prob4b.Solution`. `verify.py` reads exactly these names.

STATE (iteration 5): every one of the 20 declarations below now forwards to the
corresponding `Prob4b.<name>_proof` in `Prob4b/Proofs/**`, so none of them
depends on the `sorry`d frozen statement any more and `#print axioms` reports
`[propext, Classical.choice, Quot.sound]` throughout. Each forwarding is gated
in `Prob4b/Discharge.lean` by `example : @Prob4b.<name> = @Prob4b.<name>_proof
:= rfl`. The statements on the left of `:=` must never change.
-/

-- The frozen statements 19 and 20 bind an instance argument `inst` that their
-- statements only use implicitly; restating them verbatim is mandatory.
set_option linter.unusedVariables false

universe u

namespace Prob4b.Solution

/-- 1. `B` did not collapse: it has at least two elements. -/
theorem B_nontrivial : Nontrivial Balg := _root_.Prob4b.B_nontrivial_proof

/-- 2. The defining relation `ad + bc = 0` holds in `B`. -/
theorem B_relation : xa * xd + xb * xc = 0 := _root_.Prob4b.B_relation_proof

/-- 3. `B` is a Noetherian ring. -/
theorem B_isNoetherianRing : IsNoetherianRing Balg := _root_.Prob4b.B_isNoetherianRing_proof

/-- 4. The maximal ideal of `B` satisfies `m³ = 0`. -/
theorem B_maximalIdeal_pow_three : mB ^ 3 = ⊥ := _root_.Prob4b.B_maximalIdeal_pow_three_proof

/-- 5. `(I : m) = I + m²` for every ideal `I` generated by at most two elements. -/
theorem B_colon_two_gen :
    ∀ x y : Balg, colonI (Ideal.span {x, y}) mB = Ideal.span {x, y} ⊔ mB ^ 2 :=
  _root_.Prob4b.B_colon_two_gen_proof

/-- 6. `aB ∩ bB ∩ (a+b)B = 0` in `B`. -/
theorem B_triple_inter_eq_bot :
    Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb} = (⊥ : Ideal Balg) :=
  _root_.Prob4b.B_triple_inter_eq_bot_proof

/-- 7. `M` preserves annihilators: `(0 :_M x) = (0 :_B x)·M`. -/
theorem M_ann_eq : ∀ x : Balg, annM Mmod x = smulTop (ann x) := _root_.Prob4b.M_ann_eq_proof

/-- 8. `M` preserves pairwise principal intersections: `xM ∩ yM = (xB ∩ yB)M`. -/
theorem M_pair_inter :
    ∀ x y : Balg, (smulTop (Ideal.span {x}) : Submodule Balg Mmod) ⊓
        smulTop (Ideal.span {y}) =
      smulTop (Ideal.span {x} ⊓ Ideal.span {y}) :=
  _root_.Prob4b.M_pair_inter_proof

/-- 9. The defect element `u` is nonzero in `M`. -/
theorem M_u_ne_zero : uElt ≠ 0 := _root_.Prob4b.M_u_ne_zero_proof

/-- 10. `u ∈ aM`, `u ∈ bM` and `u ∈ (a+b)M`. -/
theorem M_u_mem_triple :
    uElt ∈ (smulTop (Ideal.span {xa}) : Submodule Balg Mmod) ⊓
      smulTop (Ideal.span {xb}) ⊓ smulTop (Ideal.span {xa + xb}) :=
  _root_.Prob4b.M_u_mem_triple_proof

/-- 11. `M` does not preserve the triple intersection `aB ∩ bB ∩ (a+b)B`. -/
theorem M_triple_defect :
    (smulTop (Ideal.span {xa}) : Submodule Balg Mmod) ⊓ smulTop (Ideal.span {xb}) ⊓
        smulTop (Ideal.span {xa + xb}) ≠
      smulTop (Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb}) :=
  _root_.Prob4b.M_triple_defect_proof

/-- 12. `C` is a Noetherian ring. -/
theorem C_isNoetherianRing : IsNoetherianRing Cring := _root_.Prob4b.C_isNoetherianRing_proof

/-- 13. `C` preserves annihilators: `(0 :_C x) = (0 :_B x)·C`. -/
theorem C_ann_eq : ∀ x : Balg, ann (iota x) = (ann x).map iota := _root_.Prob4b.C_ann_eq_proof

/-- 14. `C` preserves pairwise principal intersections: `xC ∩ yC = (xB ∩ yB)C`. -/
theorem C_pair_inter :
    ∀ x y : Balg, Ideal.span {iota x} ⊓ Ideal.span {iota y} =
      (Ideal.span {x} ⊓ Ideal.span {y}).map iota :=
  _root_.Prob4b.C_pair_inter_proof

/-- 15. The triple defect survives in `C`. -/
theorem C_triple_defect :
    Ideal.span {iota xa} ⊓ Ideal.span {iota xb} ⊓ Ideal.span {iota (xa + xb)} ≠
      (Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb}).map iota :=
  _root_.Prob4b.C_triple_defect_proof

/-- 16. `R` is a finite-conductor ring. -/
theorem R_finiteConductor : FiniteConductor Ramp := _root_.Prob4b.R_finiteConductor_proof

/-- 17. The triple intersection `aR ∩ bR ∩ (a+b)R` is not finitely generated. -/
theorem R_triple_inter_not_fg :
    ¬ (Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)} : Ideal Ramp).FG :=
  _root_.Prob4b.R_triple_inter_not_fg_proof

/-- 18. `R` is not quasi-coherent. -/
theorem R_not_quasiCoherent : ¬ QuasiCoherent Ramp := _root_.Prob4b.R_not_quasiCoherent_proof

/-- 19. Every quasi-coherent ring is a finite-conductor ring. -/
theorem quasiCoherent_imp_finiteConductor :
    ∀ {S : Type u} [inst : CommRing S], QuasiCoherent S → FiniteConductor S :=
  _root_.Prob4b.quasiCoherent_imp_finiteConductor_proof

/-- 20. HEADLINE: there is a finite-conductor ring that is not quasi-coherent. -/
theorem exists_finiteConductor_not_quasiCoherent :
    ∃ (S : Type) (inst : CommRing S), @FiniteConductor S inst ∧ ¬ @QuasiCoherent S inst :=
  _root_.Prob4b.exists_finiteConductor_not_quasiCoherent_proof

end Prob4b.Solution
