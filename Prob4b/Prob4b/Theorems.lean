/-! ## Stage A — the algebra `B` -/

/-- 1. `B` did not collapse: it has at least two elements. -/
theorem B_nontrivial : Nontrivial Balg := sorry

/-- 2. The defining relation `ad + bc = 0` holds in `B`. -/
theorem B_relation : xa * xd + xb * xc = 0 := sorry

/-- 3. `B` is a Noetherian ring. -/
theorem B_isNoetherianRing : IsNoetherianRing Balg := sorry

/-- 4. The maximal ideal of `B` satisfies `m³ = 0`. -/
theorem B_maximalIdeal_pow_three : mB ^ 3 = ⊥ := sorry

/-! ## Stage B — the colon lemma -/

/-- 5. `(I : m) = I + m²` for every ideal `I` generated by at most two elements. -/
theorem B_colon_two_gen :
    ∀ x y : Balg, colonI (Ideal.span {x, y}) mB = Ideal.span {x, y} ⊔ mB ^ 2 := sorry

/-- 6. `aB ∩ bB ∩ (a+b)B = 0` in `B`. -/
theorem B_triple_inter_eq_bot :
    Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb} = (⊥ : Ideal Balg) := sorry

/-! ## Stage C — the module `M` -/

/-- 7. `M` preserves annihilators: `(0 :_M x) = (0 :_B x)·M`. -/
theorem M_ann_eq : ∀ x : Balg, annM Mmod x = smulTop (ann x) := sorry

/-- 8. `M` preserves pairwise principal intersections: `xM ∩ yM = (xB ∩ yB)M`. -/
theorem M_pair_inter :
    ∀ x y : Balg, (smulTop (Ideal.span {x}) : Submodule Balg Mmod) ⊓
        smulTop (Ideal.span {y}) =
      smulTop (Ideal.span {x} ⊓ Ideal.span {y}) := sorry

/-- 9. The defect element `u` is nonzero in `M`. -/
theorem M_u_ne_zero : uElt ≠ 0 := sorry

/-- 10. `u ∈ aM`, `u ∈ bM` and `u ∈ (a+b)M`. -/
theorem M_u_mem_triple :
    uElt ∈ (smulTop (Ideal.span {xa}) : Submodule Balg Mmod) ⊓
      smulTop (Ideal.span {xb}) ⊓ smulTop (Ideal.span {xa + xb}) := sorry

/-- 11. `M` does not preserve the triple intersection `aB ∩ bB ∩ (a+b)B`. -/
theorem M_triple_defect :
    (smulTop (Ideal.span {xa}) : Submodule Balg Mmod) ⊓ smulTop (Ideal.span {xb}) ⊓
        smulTop (Ideal.span {xa + xb}) ≠
      smulTop (Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb}) := sorry

/-! ## Stage D — the idealization `C = B ⋉ M` -/

/-- 12. `C` is a Noetherian ring. -/
theorem C_isNoetherianRing : IsNoetherianRing Cring := sorry

/-- 13. `C` preserves annihilators: `(0 :_C x) = (0 :_B x)·C`. -/
theorem C_ann_eq : ∀ x : Balg, ann (iota x) = (ann x).map iota := sorry

/-- 14. `C` preserves pairwise principal intersections: `xC ∩ yC = (xB ∩ yB)C`. -/
theorem C_pair_inter :
    ∀ x y : Balg, Ideal.span {iota x} ⊓ Ideal.span {iota y} =
      (Ideal.span {x} ⊓ Ideal.span {y}).map iota := sorry

/-- 15. The triple defect survives in `C`. -/
theorem C_triple_defect :
    Ideal.span {iota xa} ⊓ Ideal.span {iota xb} ⊓ Ideal.span {iota (xa + xb)} ≠
      (Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb}).map iota := sorry

/-! ## Stage E — `R = Δ(B) + C^(ℕ)` is finite conductor -/

/-- 16. `R` is a finite-conductor ring. -/
theorem R_finiteConductor : FiniteConductor Ramp := sorry

/-! ## Stage F — the triple intersection in `R`, and the headline -/

/-- 17. The triple intersection `aR ∩ bR ∩ (a+b)R` is not finitely generated. -/
theorem R_triple_inter_not_fg :
    ¬ (Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)} : Ideal Ramp).FG := sorry

/-- 18. `R` is not quasi-coherent. -/
theorem R_not_quasiCoherent : ¬ QuasiCoherent Ramp := sorry

/-- 19. Every quasi-coherent ring is a finite-conductor ring. -/
theorem quasiCoherent_imp_finiteConductor :
    ∀ {S : Type u} [inst : CommRing S], QuasiCoherent S → FiniteConductor S := sorry

/-- 20. HEADLINE: there is a finite-conductor ring that is not quasi-coherent. -/
theorem exists_finiteConductor_not_quasiCoherent :
    ∃ (S : Type) (inst : CommRing S), @FiniteConductor S inst ∧ ¬ @QuasiCoherent S inst :=
  sorry

