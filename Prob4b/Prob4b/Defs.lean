import Mathlib

/-!
# Frozen definitions for Problem 4(b)

Every object the proof of "there is a finite-conductor ring that is not
quasi-coherent" needs, in dependency order.

FROZEN FILE: do not edit after SETUP, the SHA-256 of this file is pinned in
`scripts/frozen.sha256`. Support lemmas, characterisations and auxiliary
definitions belong in `Prob4b/Proofs/**`, never here.

Modeling decisions D0-D5 follow `BLUEPRINT.md` Part -1 §2 verbatim.

`USER_NOTES.md` permits no assumed-certificate axioms, so this file declares no
`axiom` and `scripts/ALLOWED_AXIOMS.txt` is empty.
-/

universe u

namespace Prob4b

noncomputable section

/-! ## D0 — generic colon / annihilator vocabulary -/

/-- The colon ideal `(I : J) = {r | r * J ⊆ I}`. -/
def colonI {S : Type*} [CommRing S] (I J : Ideal S) : Ideal S := I.colon J

/-- `(0 : x)`, the annihilator ideal of a ring element. -/
def ann {S : Type*} [CommRing S] (x : S) : Ideal S := colonI ⊥ (Ideal.span {x})

/-- `(0 :_N x)`, the annihilator submodule of `x` acting on a module `N`. -/
def annM {S : Type*} [CommRing S] (N : Type*) [AddCommGroup N] [Module S N] (x : S) :
    Submodule S N := LinearMap.ker (LinearMap.lsmul S N x)

/-- `I • N` for `N` the whole module — i.e. the submodule `I·N`. -/
def smulTop {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (I : Ideal S) : Submodule S N := I • (⊤ : Submodule S N)

/-! ## D1 — the two predicates under comparison -/

/-- `S` is a finite-conductor ring. -/
def FiniteConductor (S : Type*) [CommRing S] : Prop :=
  (∀ x : S, (ann x).FG) ∧ (∀ x y : S, (Ideal.span {x} ⊓ Ideal.span {y} : Ideal S).FG)

/-- `S` is quasi-coherent. -/
def QuasiCoherent (S : Type*) [CommRing S] : Prop :=
  (∀ x : S, (ann x).FG) ∧
    (∀ (n : ℕ) (f : Fin n → S), (⨅ i, Ideal.span {f i} : Ideal S).FG)

/-! ## D2 — the polynomial ring, the relation ideal, and `B` -/

/-- The ambient polynomial ring `F₂[a,b,c,d]`. -/
abbrev Pol : Type := MvPolynomial (Fin 4) (ZMod 2)

/-- The irrelevant maximal ideal `(a,b,c,d)` upstairs. -/
def mPol : Ideal Pol :=
  Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1, MvPolynomial.X 2, MvPolynomial.X 3}

/-- The defining relations `(a,b,c,d)³ + (ad + bc)`. -/
def relIdeal : Ideal Pol :=
  mPol ^ 3 ⊔
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 3 + MvPolynomial.X 1 * MvPolynomial.X 2}

/-- `B = F₂[a,b,c,d] / ((a,b,c,d)³, ad + bc)`. -/
abbrev Balg : Type := Pol ⧸ relIdeal

/-- The generator `a` of `B`. -/
def xa : Balg := Ideal.Quotient.mk relIdeal (MvPolynomial.X 0)

/-- The generator `b` of `B`. -/
def xb : Balg := Ideal.Quotient.mk relIdeal (MvPolynomial.X 1)

/-- The generator `c` of `B`. -/
def xc : Balg := Ideal.Quotient.mk relIdeal (MvPolynomial.X 2)

/-- The generator `d` of `B`. -/
def xd : Balg := Ideal.Quotient.mk relIdeal (MvPolynomial.X 3)

/-- The maximal ideal `m = (a,b,c,d)` of `B`. -/
def mB : Ideal Balg := Ideal.span {xa, xb, xc, xd}

/-! ## D3 — the module `M = B⁴ / Bv` and the defect element `u` -/

/-- `v = (a, b, c, d) ∈ B⁴`. -/
def vvec : Fin 4 → Balg := ![xa, xb, xc, xd]

/-- `Bv ⊆ B⁴`, the cyclic submodule generated by `v`. -/
def Nsub : Submodule Balg (Fin 4 → Balg) := Submodule.span Balg {vvec}

/-- `M = B⁴ / Bv`. -/
abbrev Mmod : Type := (Fin 4 → Balg) ⧸ Nsub

/-- The defect element `u = [(0, ab + b², 0, bc + bd)]`. -/
def uElt : Mmod :=
  Submodule.Quotient.mk ![0, xa * xb + xb * xb, 0, xb * xc + xb * xd]

/-! ## D4 — the idealization `C = B ⋉ M` -/

/-- `C = B ⋉ M`, the trivial square-zero (Nagata) extension. -/
abbrev Cring : Type := TrivSqZeroExt Balg Mmod

/-- `B ↪ C`, `x ↦ (x, 0)`. -/
def iota : Balg →+* Cring := TrivSqZeroExt.inlHom Balg Mmod

/-! ## D5 — the amplified ring `R = Δ(B) + C^(ℕ)` -/

/-- `R = Δ(B) + C^(ℕ)`: the sequences in `C^ℕ` that are constant, equal to a
diagonal element of `B`, outside a finite set of coordinates. -/
def Rsub : Subring (ℕ → Cring) where
  carrier := {f | ∃ x : Balg, {n | f n ≠ iota x}.Finite}
  zero_mem' := ⟨0, by
    have h : {n : ℕ | (0 : ℕ → Cring) n ≠ iota 0} = (∅ : Set ℕ) := by
      ext n; simp
    rw [h]; exact Set.finite_empty⟩
  one_mem' := ⟨1, by
    have h : {n : ℕ | (1 : ℕ → Cring) n ≠ iota 1} = (∅ : Set ℕ) := by
      ext n; simp
    rw [h]; exact Set.finite_empty⟩
  add_mem' := by
    rintro f g ⟨x, hx⟩ ⟨y, hy⟩
    refine ⟨x + y, (hx.union hy).subset fun n hn => ?_⟩
    by_contra hcon
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hcon
    exact hn (by simp [hcon.1, hcon.2])
  neg_mem' := by
    rintro f ⟨x, hx⟩
    refine ⟨-x, hx.subset fun n hn => ?_⟩
    by_contra hcon
    simp only [Set.mem_setOf_eq, not_not] at hcon
    exact hn (by simp [hcon])
  mul_mem' := by
    rintro f g ⟨x, hx⟩ ⟨y, hy⟩
    refine ⟨x * y, (hx.union hy).subset fun n hn => ?_⟩
    by_contra hcon
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hcon
    exact hn (by simp [hcon.1, hcon.2])

/-- `R` as a commutative ring. -/
abbrev Ramp : Type := Rsub

/-- `Δ : B → R`, the diagonal copy of `B`. -/
def diag : Balg →+* Ramp where
  toFun x := ⟨fun _ => iota x, ⟨x, by
    have h : {n : ℕ | (fun _ : ℕ => iota x) n ≠ iota x} = (∅ : Set ℕ) := by
      ext n; simp
    rw [h]; exact Set.finite_empty⟩⟩
  map_one' := Subtype.ext (by funext n; simp)
  map_mul' _ _ := Subtype.ext (by funext n; simp)
  map_zero' := Subtype.ext (by funext n; simp)
  map_add' _ _ := Subtype.ext (by funext n; simp)

/-- The element of `R` carrying the defect `(0, u) ∈ C` in coordinate `n` and `0`
elsewhere. -/
def uAt (n : ℕ) : Ramp :=
  ⟨fun k => if k = n then TrivSqZeroExt.inr uElt else 0, ⟨0,
    (Set.finite_singleton n).subset (by
      intro k hk
      simp only [Set.mem_setOf_eq] at hk
      by_contra hne
      simp only [Set.mem_singleton_iff] at hne
      simp [hne] at hk)⟩⟩

end

end Prob4b
