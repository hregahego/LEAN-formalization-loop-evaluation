import Prob4b.Proofs.StageA_Algebra.Basic
import Prob4b.Proofs.StageA_Algebra.NormalForm

/-!
# Stage B, step B2 — the triple intersection `aB ⊓ bB ⊓ (a+b)B = ⊥`

This module delivers frozen theorem 6,

`B_triple_inter_eq_bot_proof :
  Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb} = (⊥ : Ideal Balg)`,

independently of the colon lemma B1.

The argument is the graded computation of `BLUEPRINT.md` Stage B, step B2, done
entirely in coordinates through the Stage A normal form `nf`.  The key structural
input is `tri_mem_span_singleton`: if `s` lies in the maximal ideal `m` then

`s·B = F₂·s + F₂·(s·a) + F₂·(s·b) + F₂·(s·c) + F₂·(s·d)`,

because `s` annihilates `m²` (Stage A's `mul_mem_mB_three`) and the classes of the
fourteen basis monomials span `B` (Stage A's `sec_nf`).  Reading off coordinates:

* an element of `aB` has zero `b²` and `bd` coordinates;
* an element of `bB` has zero `a`, `a²` and `ac`
  coordinates (note `bc = ad`, so `b·c` contributes to the `ad` coordinate);
* an element of `(a+b)B` is `c·(a+b) + c₀(a²+ab) + c₁(ab+b²) + c₂(ac+ad) +
  c₃(ad+bd)`, and the five vanishing coordinates above force
  `c = c₀ = c₁ = c₂ = c₃ = 0`.

Every support lemma in this file carries the `tri_` prefix, as mandated by the
iteration's task assignment.
-/

open MvPolynomial

namespace Prob4b

/-! ## Degree-one elements of `B` -/

/-- The generator `a` lies in the maximal ideal. -/
theorem tri_xa_mem_mB : xa ∈ mB := Ideal.subset_span (by simp)

/-- The generator `b` lies in the maximal ideal. -/
theorem tri_xb_mem_mB : xb ∈ mB := Ideal.subset_span (by simp)

/-- The generator `c` lies in the maximal ideal. -/
theorem tri_xc_mem_mB : xc ∈ mB := Ideal.subset_span (by simp)

/-- The generator `d` lies in the maximal ideal. -/
theorem tri_xd_mem_mB : xd ∈ mB := Ideal.subset_span (by simp)

/-- The element `a + b` lies in the maximal ideal. -/
theorem tri_sum_mem_mB : xa + xb ∈ mB := Ideal.add_mem _ tri_xa_mem_mB tri_xb_mem_mB

/-- The class of every polynomial variable lies in the maximal ideal. -/
theorem tri_gen_mem_mB (k : Fin 4) : (Ideal.Quotient.mk relIdeal (X k) : Balg) ∈ mB := by
  fin_cases k
  exacts [tri_xa_mem_mB, tri_xb_mem_mB, tri_xc_mem_mB, tri_xd_mem_mB]

/-! ## The five-term shape of a principal ideal generated in degree one -/

/-- The basis monomial of index `Sum.inl ()` is `1`. -/
theorem tri_monB_one : monB (Sum.inl ()) = 1 := by
  rw [monB, monoExp_inl]
  simp

/-- The degree-one basis monomials are the classes of the variables. -/
theorem tri_monB_lin (k : Fin 4) :
    monB (Sum.inr (Sum.inl k)) = Ideal.Quotient.mk relIdeal (X k) := by
  rw [monB, monoExp_lin, X]

/-- The degree-two basis monomials are products of two variable classes. -/
theorem tri_monB_quad (j : Fin 9) :
    monB (Sum.inr (Sum.inr j)) =
      Ideal.Quotient.mk relIdeal (X (deg2 j).1) * Ideal.Quotient.mk relIdeal (X (deg2 j).2) := by
  rw [mk_X_mul_mk_X, monB, monoExp_quad]

/-- Multiplying a degree-two basis monomial by an element of the maximal ideal
gives `0`, since `m³ = 0`. -/
theorem tri_monB_quad_mul {s : Balg} (hs : s ∈ mB) (j : Fin 9) :
    monB (Sum.inr (Sum.inr j)) * s = 0 := by
  rw [tri_monB_quad]
  exact mul_mem_mB_three (tri_gen_mem_mB _) (tri_gen_mem_mB _) hs

/-- Structure of a principal ideal generated by an element `s` of the maximal
ideal: every multiple of `s` is an `F₂`-combination of `s` and the four products
`s·a`, `s·b`, `s·c`, `s·d`.  This is the graded statement `s·B = F₂·s ⊕ s·V` of
`BLUEPRINT.md` Stage B, step B2. -/
theorem tri_mem_span_singleton {s : Balg} (hs : s ∈ mB) {z : Balg}
    (hz : z ∈ Ideal.span {s}) :
    ∃ c c0 c1 c2 c3 : ZMod 2,
      z = c • s + (c0 • (s * xa) + c1 • (s * xb) + c2 • (s * xc) + c3 • (s * xd)) := by
  obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.1 hz
  refine ⟨nf w (Sum.inl ()), nf w (Sum.inr (Sum.inl 0)), nf w (Sum.inr (Sum.inl 1)),
    nf w (Sum.inr (Sum.inl 2)), nf w (Sum.inr (Sum.inl 3)), ?_⟩
  have hw : w = ∑ i : Idx, nf w i • monB i := by rw [← sec_apply, sec_nf_apply]
  have h9 : ∑ j : Fin 9, nf w (Sum.inr (Sum.inr j)) • (monB (Sum.inr (Sum.inr j)) * s) = 0 :=
    Finset.sum_eq_zero fun j _ => by rw [tri_monB_quad_mul hs j, smul_zero]
  calc w * s = (∑ i : Idx, nf w i • monB i) * s := by rw [← hw]
    _ = ∑ i : Idx, nf w i • (monB i * s) := by
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => smul_mul_assoc _ _ _
    _ = nf w (Sum.inl ()) • (monB (Sum.inl ()) * s)
          + ∑ k : Fin 4, nf w (Sum.inr (Sum.inl k)) • (monB (Sum.inr (Sum.inl k)) * s) := by
        rw [Fintype.sum_sum_type, Fintype.sum_sum_type, h9, add_zero]
        congr 1
        simp
    _ = _ := by
        rw [Fin.sum_univ_four, tri_monB_one, one_mul, tri_monB_lin, tri_monB_lin,
          tri_monB_lin, tri_monB_lin]
        rw [show (Ideal.Quotient.mk relIdeal (X 0) : Balg) = xa from rfl,
          show (Ideal.Quotient.mk relIdeal (X 1) : Balg) = xb from rfl,
          show (Ideal.Quotient.mk relIdeal (X 2) : Balg) = xc from rfl,
          show (Ideal.Quotient.mk relIdeal (X 3) : Balg) = xd from rfl,
          mul_comm xa s, mul_comm xb s, mul_comm xc s, mul_comm xd s]

/-! ## Coordinate consequences -/

/-- The normal form of `b·a`, obtained from `nf_xa_mul_xb` by commutativity. -/
theorem tri_nf_xb_mul_xa : nf (xb * xa) = Pi.single (Sum.inr (Sum.inr 1)) 1 := by
  rw [mul_comm]
  exact nf_xa_mul_xb

/-- An element of `aB` has vanishing `b²` and `bd` coordinates. -/
theorem tri_nf_span_xa {z : Balg} (hz : z ∈ Ideal.span {xa}) :
    nf z (Sum.inr (Sum.inr 4)) = 0 ∧ nf z (Sum.inr (Sum.inr 5)) = 0 := by
  obtain ⟨c, c0, c1, c2, c3, hzeq⟩ := tri_mem_span_singleton tri_xa_mem_mB hz
  subst hzeq
  constructor <;>
    simp [nf_xa, nf_xa_mul_xa, nf_xa_mul_xb, nf_xa_mul_xc, nf_xa_mul_xd, adIdx]

/-- An element of `bB` has vanishing `a`, `a²` and `ac` coordinates.  Note that
`b·c` contributes to the `ad` coordinate, since `bc = ad` in `B`. -/
theorem tri_nf_span_xb {z : Balg} (hz : z ∈ Ideal.span {xb}) :
    nf z (Sum.inr (Sum.inl 0)) = 0 ∧ nf z (Sum.inr (Sum.inr 0)) = 0 ∧
      nf z (Sum.inr (Sum.inr 2)) = 0 := by
  obtain ⟨c, c0, c1, c2, c3, hzeq⟩ := tri_mem_span_singleton tri_xb_mem_mB hz
  subst hzeq
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [nf_xb, tri_nf_xb_mul_xa, nf_xb_mul_xb, nf_xb_mul_xc, nf_xb_mul_xd, adIdx]

/-- `nf ((a+b)·a) = e_{a²} + e_{ab}`. -/
theorem tri_nf_sum_mul_xa :
    nf ((xa + xb) * xa)
      = Pi.single (Sum.inr (Sum.inr 0)) 1 + Pi.single (Sum.inr (Sum.inr 1)) 1 := by
  rw [add_mul, map_add, nf_xa_mul_xa, tri_nf_xb_mul_xa]

/-- `nf ((a+b)·b) = e_{ab} + e_{b²}`. -/
theorem tri_nf_sum_mul_xb :
    nf ((xa + xb) * xb)
      = Pi.single (Sum.inr (Sum.inr 1)) 1 + Pi.single (Sum.inr (Sum.inr 4)) 1 := by
  rw [add_mul, map_add, nf_xa_mul_xb, nf_xb_mul_xb]

/-- `nf ((a+b)·c) = e_{ac} + e_{ad}` (using `bc = ad`). -/
theorem tri_nf_sum_mul_xc :
    nf ((xa + xb) * xc) = Pi.single (Sum.inr (Sum.inr 2)) 1 + Pi.single adIdx 1 := by
  rw [add_mul, map_add, nf_xa_mul_xc, nf_xb_mul_xc]

/-- `nf ((a+b)·d) = e_{ad} + e_{bd}`. -/
theorem tri_nf_sum_mul_xd :
    nf ((xa + xb) * xd) = Pi.single adIdx 1 + Pi.single (Sum.inr (Sum.inr 5)) 1 := by
  rw [add_mul, map_add, nf_xa_mul_xd, nf_xb_mul_xd]

/-! ## Frozen theorem 6 -/

/-- Frozen theorem 6: `aB ∩ bB ∩ (a+b)B = 0` in `B`. -/
theorem B_triple_inter_eq_bot_proof :
    Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb} = (⊥ : Ideal Balg) := by
  refine le_antisymm ?_ bot_le
  intro z hz
  simp only [Submodule.mem_inf] at hz
  obtain ⟨⟨hza, hzb⟩, hzab⟩ := hz
  obtain ⟨hb2, hbd⟩ := tri_nf_span_xa hza
  obtain ⟨ha, ha2, hac⟩ := tri_nf_span_xb hzb
  obtain ⟨c, c0, c1, c2, c3, hzeq⟩ := tri_mem_span_singleton tri_sum_mem_mB hzab
  rw [hzeq] at ha ha2 hb2 hac hbd
  simp [nf_xa, nf_xb, tri_nf_sum_mul_xa, tri_nf_sum_mul_xb, tri_nf_sum_mul_xc,
    tri_nf_sum_mul_xd, adIdx] at ha ha2 hb2 hac hbd
  simp [hzeq, ha, ha2, hb2, hac, hbd]

/-! ## Guardrails -/

/-- Guardrail: the *pairwise* intersection `aB ⊓ bB` is not zero, so the triple
intersection above is a genuine statement and `B` did not collapse. -/
example : xa * xb ∈ Ideal.span {xa} ⊓ Ideal.span {xb} ∧ xa * xb ≠ 0 := by
  refine ⟨⟨Ideal.mem_span_singleton'.2 ⟨xb, mul_comm xb xa⟩,
    Ideal.mem_span_singleton'.2 ⟨xa, rfl⟩⟩, ?_⟩
  intro h
  have h1 : nf (xa * xb) = nf 0 := congrArg nf h
  rw [nf_xa_mul_xb, map_zero] at h1
  have h2 := congrFun h1 (Sum.inr (Sum.inr 1))
  rw [Pi.single_eq_same] at h2
  exact one_ne_zero h2

end Prob4b
