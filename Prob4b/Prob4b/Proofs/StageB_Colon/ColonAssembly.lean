import Prob4b.Proofs.StageB_Colon.LinAlg
import Prob4b.Proofs.StageB_Colon.LinAlgRank2

/-!
# Stage B — assembly of the colon lemma (frozen theorem 5)

This module covers `BLUEPRINT.md` Part 2 Stage B step B1, following `SKETCH.md`
lines 99–105: `(I : m) = I + m²` for every ideal `I` of `B` generated by at most
two elements.

Everything here is an ASSEMBLY of results already proved elsewhere; no new finite
enumeration is performed.

* `⊇` is `colon_le_colonI` (`Prob4b/Proofs/StageB_Colon/Basic.lean`), valid for
  every ideal `I`.
* `⊆` splits into three branches. If one of the two generators is not in `mB` it
  is a unit (`isUnit_of_not_mem_mB`) and both sides are `⊤`. If both generators
  lie in `mB` and their degree-one parts are `F₂`-dependent, the rank-≤1 leaf
  `lin1_rank_le_one_case` (`Prob4b/Proofs/StageB_Colon/LinAlg.lean`) closes it.
  The remaining rank-two branch is `ca_rank_two_case` below, which uses the
  rank-two leaf `lin2_not_mem_sum'`
  (`Prob4b/Proofs/StageB_Colon/LinAlgRank2.lean`).

Delivered here:

* `ca_rank_two_case` — the rank-two branch of the hard inclusion;
* `B_colon_two_gen_proof` — frozen theorem 5, stated over all of `Balg`.

Every declaration of this file is `sorry`-free and uses no `decide` at all.
-/

namespace Prob4b

/-! ## The rank-two branch -/

/-- The rank-two branch of frozen theorem 5 (`B_colon_two_gen`): if both
generators lie in `mB` and their degree-one parts `colon_co x`, `colon_co y` are
`F₂`-independent (over `F₂` that is exactly: both nonzero and distinct), then the
colon ideal of `Ideal.span {x, y}` by `mB` is contained in
`Ideal.span {x, y} ⊔ mB ^ 2`.

This is an explicitly-scoped sub-case lemma, not the frozen statement; the
rank-≤1 branch is `lin1_rank_le_one_case` and the unit case is handled in
`B_colon_two_gen_proof`. -/
theorem ca_rank_two_case (x y t : Balg) (hx : x ∈ mB) (hy : y ∈ mB)
    (hcx : colon_co x ≠ 0) (hcy : colon_co y ≠ 0) (hxy : colon_co x ≠ colon_co y)
    (ht : t ∈ colonI (Ideal.span {x, y}) mB) :
    t ∈ Ideal.span {x, y} ⊔ mB ^ 2 := by
  have hxs : x ∈ Ideal.span ({x, y} : Set Balg) := Ideal.subset_span (by simp)
  have hys : y ∈ Ideal.span ({x, y} : Set Balg) := Ideal.subset_span (by simp)
  have htm : t ∈ mB := colon_mem_mB_of_mem_colonI x y t hx hy ht
  obtain ⟨w, hw, hteq⟩ := colon_deg_split t htm
  obtain ⟨wx, hwx, hxeq⟩ := colon_deg_split x hx
  obtain ⟨wy, hwy, hyeq⟩ := colon_deg_split y hy
  have hcot : (fun k => nf t (Sum.inr (Sum.inl k))) = colon_co t := rfl
  have hcox : (fun k => nf x (Sum.inr (Sum.inl k))) = colon_co x := rfl
  have hcoy : (fun k => nf y (Sum.inr (Sum.inl k))) = colon_co y := rfl
  rw [hcot] at hteq
  rw [hcox] at hxeq
  rw [hcoy] at hyeq
  have hlinx : colon_lin (colon_co x) = x - wx := eq_sub_of_add_eq hxeq.symm
  have hliny : colon_lin (colon_co y) = y - wy := eq_sub_of_add_eq hyeq.symm
  by_cases hst0 : colon_co t = 0
  · rw [hteq, hst0, colon_lin_zero, zero_add]
    exact Submodule.mem_sup_right hw
  by_cases hstx : colon_co t = colon_co x
  · have hrw : t = x + (w - wx) := by rw [hteq, hstx, hlinx]; ring
    rw [hrw]
    exact Submodule.add_mem _ (Submodule.mem_sup_left hxs)
      (Submodule.mem_sup_right (Submodule.sub_mem _ hw hwx))
  by_cases hsty : colon_co t = colon_co y
  · have hrw : t = y + (w - wy) := by rw [hteq, hsty, hliny]; ring
    rw [hrw]
    exact Submodule.add_mem _ (Submodule.mem_sup_left hys)
      (Submodule.mem_sup_right (Submodule.sub_mem _ hw hwy))
  by_cases hstxy : colon_co t = colon_co x + colon_co y
  · have hrw : t = x + y + (w - wx - wy) := by
      rw [hteq, hstxy, colon_lin_add, hlinx, hliny]; ring
    rw [hrw]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (Ideal.add_mem _ hxs hys))
      (Submodule.mem_sup_right (Submodule.sub_mem _ (Submodule.sub_mem _ hw hwx) hwy))
  exfalso
  -- In the rank-two branch the two `F₂`-coefficients of the ideal description
  -- vanish, so every degree-two product `st · z` lies in `cx · V + cy · V`.
  have key : ∀ z : Fin 4 → ZMod 2, ∃ u v : Fin 4 → ZMod 2,
      colon_mulc (colon_co t) z
        = colon_mulc u (colon_co x) + colon_mulc v (colon_co y) := by
    intro z
    obtain ⟨α, β, u, v, heq⟩ := (colon_span_pair_desc x y _ hx hy).1
      (colon_lin_mul_mem x y t hx hy ht z)
    have h0 : colon_co (colon_lin (colon_co t) * colon_lin z) = 0 :=
      colon_co_mul (colon_lin_mem_mB _) (colon_lin_mem_mB z)
    rw [heq, colon_co_add, colon_co_add, colon_co_add, colon_co_smul, colon_co_smul,
      colon_co_mul (colon_lin_mem_mB u) hx, colon_co_mul (colon_lin_mem_mB v) hy] at h0
    simp only [add_zero] at h0
    obtain ⟨hα, hβ⟩ := lin2_smul_eq_zero hcx hcy hxy h0
    have e0 : colon_lin u * wx = 0 := by
      rw [mul_comm]; exact colon_sq_mul wx _ hwx (colon_lin_mem_mB u)
    have e1 : colon_lin v * wy = 0 := by
      rw [mul_comm]; exact colon_sq_mul wy _ hwy (colon_lin_mem_mB v)
    have e2 : colon_lin u * x = colon_lin u * colon_lin (colon_co x) := by
      conv_lhs => rw [hxeq]
      rw [mul_add, e0, add_zero]
    have e3 : colon_lin v * y = colon_lin v * colon_lin (colon_co y) := by
      conv_lhs => rw [hyeq]
      rw [mul_add, e1, add_zero]
    simp only [hα, hβ, zero_smul, zero_add] at heq
    rw [e2, e3] at heq
    refine ⟨u, v, ?_⟩
    rw [← lin1_q_lin_mul, heq, lin1_q_add, lin1_q_lin_mul, lin1_q_lin_mul]
  obtain ⟨z, hz⟩ := lin2_not_mem_sum' (colon_co x) (colon_co y) (colon_co t)
    hcx hcy hxy hst0 hstx hsty hstxy
  obtain ⟨u, v, huv⟩ := key z
  exact hz u v huv

/-! ## Frozen theorem 5 -/

/-- Frozen theorem 5 (`B_colon_two_gen`): `(I : m) = I + m²` for every ideal `I`
of `B` generated by at most two elements.

The statement is over ALL `x y : Balg`: the case where a generator is a unit and
the degenerate cases where the degree-one parts of the generators are dependent
are part of the theorem, not excluded by a hypothesis. -/
theorem B_colon_two_gen_proof :
    ∀ x y : Balg, colonI (Ideal.span {x, y}) mB = Ideal.span {x, y} ⊔ mB ^ 2 := by
  intro x y
  refine le_antisymm ?_ (colon_le_colonI _)
  by_cases hx : x ∈ mB
  · by_cases hy : y ∈ mB
    · intro t ht
      by_cases hdep : colon_co x = 0 ∨ colon_co y = 0 ∨ colon_co x = colon_co y
      · exact lin1_rank_le_one_case x y t hx hy hdep ht
      · rw [not_or, not_or] at hdep
        exact ca_rank_two_case x y t hx hy hdep.1 hdep.2.1 hdep.2.2 ht
    · have htop : Ideal.span ({x, y} : Set Balg) = ⊤ :=
        Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp))
          (isUnit_of_not_mem_mB y hy)
      rw [htop]
      exact le_top.trans le_sup_left
  · have htop : Ideal.span ({x, y} : Set Balg) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp))
        (isUnit_of_not_mem_mB x hx)
    rw [htop]
    exact le_top.trans le_sup_left

/-! ## Guardrails

The two `example`s mandated by `BLUEPRINT.md`'s Stage B cheat-watch (e) live in
`Prob4b/Proofs/StageB_Colon/Basic.lean` (`colonI ⊥ mB = mB ^ 2` and
`xa * xb ∈ Ideal.span {xa} ⊓ Ideal.span {xb}`) and are reachable from here
through the import chain. The two below check that the frozen theorem just
proved is compatible with them: its `I = ⊥` instance is the first guardrail, and
it does not degenerate to `colonI I mB = ⊤`. -/

/-- The `I = ⊥` instance of frozen theorem 5 agrees with the independently proved
`colon_bot_eq`, so the reduction did not drift. -/
example : colonI (Ideal.span {(0 : Balg), 0}) mB = mB ^ 2 := by
  rw [B_colon_two_gen_proof 0 0]
  simp

/-- Frozen theorem 5 does not collapse to `colonI I mB = ⊤`: for `I = ⊥` the
colon ideal is `mB ^ 2`, which is a proper ideal since `1 ∉ mB ^ 2`. -/
example : colonI (Ideal.span {(0 : Balg), 0}) mB ≠ ⊤ := by
  rw [B_colon_two_gen_proof 0 0]
  intro h
  have h1 : (1 : Balg) ∈ Ideal.span ({(0 : Balg), 0} : Set Balg) ⊔ mB ^ 2 := by
    rw [h]; trivial
  simp only [Set.pair_eq_singleton, Ideal.span_singleton_eq_bot.2 rfl, bot_sup_eq] at h1
  have h2 := (colon_mem_mB_sq_iff (1 : Balg)).1 h1
  have h3 : nf (1 : Balg) (Sum.inl ()) = 1 := by rw [nf_one, Pi.single_eq_same]
  rw [h2.1] at h3
  exact zero_ne_one h3

end Prob4b
