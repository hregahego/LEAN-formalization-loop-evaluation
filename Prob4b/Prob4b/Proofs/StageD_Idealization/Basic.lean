/-!
# Stage D — the idealization `C = B ⋉ M`

Delivers `C_isNoetherianRing_proof`, `C_ann_eq_proof`, `C_pair_inter_proof`
and `C_triple_defect_proof`.

Iteration 1 delivered the dependency-free support steps **D1** and **D2**:
the description of the extension `Ideal.map iota J` of an ideal of `B` to
`C = B ⋉ M` as the set of pairs `(z, n)` with `z ∈ J` and `n ∈ J·M`
(`map_iota_eq`), its two corollaries `iota_mem_map_iff` and `span_iota_eq`, and
the arithmetic simp lemmas for `iota` they rest on.

Iteration 2 adds step **D5**, the frozen theorem `C_isNoetherianRing`, via the
finiteness route: the Stage A basis `basisB` makes `B` a finite type, hence so
are its quotient-of-`B⁴` module `M` and the idealization `C = B ⋉ M`, and every
ideal of a finite ring is finitely generated by its own underlying set.

Iteration 3 adds step **D6**, the frozen theorem `C_triple_defect`: the element
`inr u` lies in all three principal ideals `(iota s)·C` while the extension of
`aB ∩ bB ∩ (a+b)B = ⊥` is `⊥`.

Steps D3 and D4 (`C_ann_eq`, `C_pair_inter`) need Stage C's `M_ann_eq` /
`M_pair_inter` and are not attempted here.

Iteration 4 supersedes that last paragraph: it adds steps **D3** and **D4** in
*hypothesis-parametrized* form, `di_ann_eq_of_M` and `di_pair_inter_of_M`,
taking Stage C's `M_ann_eq` / `M_pair_inter` (frozen theorems 7 and 8, still
being proved) as explicit hypotheses `hM7` / `hM8`.  Once those land, the frozen
theorems 13 and 14 are the one-line instantiations
`di_ann_eq_of_M M_ann_eq_proof` and `di_pair_inter_of_M M_pair_inter_proof`.
-/

namespace Prob4b

noncomputable section

/-! ## Arithmetic of `iota : B →+* C` -/

/-- `iota` is the inclusion `x ↦ (x, 0)` of `B` into `C = B ⋉ M`. -/
theorem iota_apply (x : Balg) : iota x = TrivSqZeroExt.inl x := rfl

@[simp]
theorem iota_apply_fst (x : Balg) : (iota x).fst = x := rfl

@[simp]
theorem iota_apply_snd (x : Balg) : (iota x).snd = 0 := rfl

@[simp]
theorem iota_mul_fst (x : Balg) (c : Cring) : (iota x * c).fst = x * c.fst := rfl

@[simp]
theorem iota_mul_snd (x : Balg) (c : Cring) : (iota x * c).snd = x • c.snd := by
  rw [TrivSqZeroExt.snd_mul, iota_apply_fst, iota_apply_snd, smul_zero, add_zero]

/-- `iota x * (z, n) = (x * z, x • n)`. -/
theorem iota_mul_eq (x : Balg) (c : Cring) :
    iota x * c = TrivSqZeroExt.inl (x * c.fst) + TrivSqZeroExt.inr (x • c.snd) :=
  TrivSqZeroExt.ext (by simp) (by simp)

/-! ## D1 — the extension `Ideal.map iota J` -/

/-- `j • n ∈ J·M` whenever `j ∈ J`; the basic membership test for `smulTop`. -/
theorem smul_mem_smulTop {J : Ideal Balg} {j : Balg} (hj : j ∈ J) (n : Mmod) :
    j • n ∈ (smulTop J : Submodule Balg Mmod) :=
  Submodule.smul_mem_smul hj Submodule.mem_top

/-- The candidate description of `Ideal.map iota J`, packaged as an ideal of `C`:
the pairs `(z, n)` with `z ∈ J` and `n ∈ J·M`. -/
def mapIotaIdeal (J : Ideal Balg) : Ideal Cring where
  carrier := {c : Cring | c.fst ∈ J ∧ c.snd ∈ (smulTop J : Submodule Balg Mmod)}
  zero_mem' := ⟨J.zero_mem, Submodule.zero_mem _⟩
  add_mem' := fun hc hd => ⟨J.add_mem hc.1 hd.1, Submodule.add_mem _ hc.2 hd.2⟩
  smul_mem' := fun c d hd => by
    refine ⟨?_, ?_⟩
    · rw [smul_eq_mul, TrivSqZeroExt.fst_mul]
      exact Ideal.mul_mem_left _ _ hd.1
    · rw [smul_eq_mul, TrivSqZeroExt.snd_mul]
      refine Submodule.add_mem _ (Submodule.smul_mem _ _ hd.2) ?_
      rw [op_smul_eq_smul]
      exact smul_mem_smulTop hd.1 _

@[simp]
theorem mem_mapIotaIdeal {J : Ideal Balg} {c : Cring} :
    c ∈ mapIotaIdeal J ↔ c.fst ∈ J ∧ c.snd ∈ (smulTop J : Submodule Balg Mmod) :=
  Iff.rfl

/-- **D1, membership form.** `c ∈ J·C` iff its `B`-part lies in `J` and its
`M`-part lies in `J·M`. -/
theorem mem_map_iota_iff (J : Ideal Balg) (c : Cring) :
    c ∈ Ideal.map iota J ↔
      c.fst ∈ J ∧ c.snd ∈ (smulTop J : Submodule Balg Mmod) := by
  constructor
  · have hle : Ideal.map iota J ≤ mapIotaIdeal J := by
      rw [Ideal.map_le_iff_le_comap]
      intro j hj
      exact ⟨hj, Submodule.zero_mem _⟩
    exact fun hc => hle hc
  · rintro ⟨h1, h2⟩
    rw [← TrivSqZeroExt.inl_fst_add_inr_snd_eq c]
    refine Ideal.add_mem _ (Ideal.mem_map_of_mem iota h1) ?_
    refine Submodule.smul_induction_on h2 ?_ ?_
    · intro j hj n _
      rw [← TrivSqZeroExt.inl_mul_inr j n]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem iota hj)
    · intro m₁ m₂ hm₁ hm₂
      rw [TrivSqZeroExt.inr_add]
      exact Ideal.add_mem _ hm₁ hm₂

/-- **D1.** The extension to `C = B ⋉ M` of an ideal `J` of `B` is
`{(z, n) | z ∈ J, n ∈ J·M}`. -/
theorem map_iota_eq (J : Ideal Balg) :
    (Ideal.map iota J : Set Cring) =
      {c : Cring | c.fst ∈ J ∧ c.snd ∈ (smulTop J : Submodule Balg Mmod)} :=
  Set.ext fun c => mem_map_iota_iff J c

/-- The extension along `iota` does not enlarge `J`: `iota z ∈ J·C ↔ z ∈ J`.
Stage E consumes this. -/
theorem iota_mem_map_iff (J : Ideal Balg) (z : Balg) :
    iota z ∈ Ideal.map iota J ↔ z ∈ J := by
  rw [mem_map_iota_iff, iota_apply_fst, iota_apply_snd]
  simp

/-! ## D2 — the principal case -/

/-- The extension of a principal ideal is principal: `(xB)·C = (iota x)·C`. -/
theorem map_iota_span_singleton (x : Balg) :
    Ideal.map iota (Ideal.span {x}) = Ideal.span {iota x} := by
  rw [Ideal.map_span, Set.image_singleton]

/-- **D2.** `(iota x)·C = {(z, n) | z ∈ xB, n ∈ xM}`, because
`iota x * (z, n) = (x * z, x • n)`. -/
theorem span_iota_eq (x : Balg) :
    (Ideal.span {iota x} : Set Cring) =
      {c : Cring | c.fst ∈ Ideal.span {x} ∧
        c.snd ∈ (smulTop (Ideal.span {x}) : Submodule Balg Mmod)} := by
  rw [← map_iota_span_singleton x, map_iota_eq]

/-- **D2, membership form.** -/
theorem mem_span_iota_iff (x : Balg) (c : Cring) :
    c ∈ Ideal.span {iota x} ↔
      c.fst ∈ Ideal.span {x} ∧
        c.snd ∈ (smulTop (Ideal.span {x}) : Submodule Balg Mmod) := by
  rw [← map_iota_span_singleton x, mem_map_iota_iff]

/-! ## D5 — `C` is a Noetherian ring

The route is the finiteness one: `basisB : Module.Basis Idx (ZMod 2) Balg` with
`Idx` a `Fintype` identifies `B` with `Idx → ZMod 2`, so `B` is a finite type;
`M = B⁴ / Bv` is a quotient of the finite type `Fin 4 → Balg`; and
`C = B ⋉ M` is (definitionally) `Balg × Mmod`.  A ring with finitely many
elements is Noetherian because every ideal is spanned by its own finite
underlying set — `isNoetherian_of_finite`, applied with both arguments equal to
`Cring`, so this is finite generation of `Cring`-IDEALS, not of `C` as a
`B`-module. -/

/-- `B` is a finite type: the Stage A basis identifies it with `Idx → ZMod 2`. -/
theorem finite_Balg : Finite Balg :=
  Finite.of_equiv _ basisB.equivFun.symm.toEquiv

/-- `M = B⁴ / Bv` is a finite type, being a quotient of the finite type `B⁴`. -/
theorem finite_Mmod : Finite Mmod :=
  haveI := finite_Balg
  Finite.of_surjective (Submodule.Quotient.mk (p := Nsub))
    (Submodule.Quotient.mk_surjective Nsub)

/-- `C = B ⋉ M` is a finite type: as a type it is `B × M`. -/
theorem finite_Cring : Finite Cring :=
  haveI := finite_Balg
  haveI := finite_Mmod
  Finite.of_equiv (Balg × Mmod) (Equiv.refl _)

/-- **D5 (frozen theorem 12).** `C = B ⋉ M` is a Noetherian ring: every ideal
of `C` is finitely generated. -/
theorem C_isNoetherianRing_proof : IsNoetherianRing Cring :=
  haveI := finite_Cring
  isNoetherian_of_finite Cring Cring

/-! ## D6 — the triple defect survives in `C` -/

/-- The purely-module-side element `(0, u) = inr u` of `C` lies in `(iota s)·C`
as soon as `u ∈ sM`: its `fst` is `0 ∈ sB` and its `snd` is `u ∈ sM`. -/
theorem mem_span_iota_inr {s : Balg} {m : Mmod}
    (hm : m ∈ (smulTop (Ideal.span {s}) : Submodule Balg Mmod)) :
    (TrivSqZeroExt.inr m : Cring) ∈ Ideal.span {iota s} := by
  rw [mem_span_iota_iff]
  refine ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_inr]
    exact Submodule.zero_mem _
  · rw [TrivSqZeroExt.snd_inr]
    exact hm

/-- `inr u ≠ 0` in `C`, because `u ≠ 0` in `M` and `TrivSqZeroExt.snd (inr m) = m`. -/
theorem inr_uElt_ne_zero : (TrivSqZeroExt.inr uElt : Cring) ≠ 0 := by
  intro h
  apply M_u_ne_zero_proof
  have h2 := congrArg TrivSqZeroExt.snd h
  rwa [TrivSqZeroExt.snd_inr, TrivSqZeroExt.snd_zero] at h2

/-- **D6 (frozen theorem 15).** The triple defect survives in `C = B ⋉ M`: the
intersection of the three principal ideals contains the nonzero element
`inr u`, whereas the extension of `aB ∩ bB ∩ (a+b)B = ⊥` is `⊥`. -/
theorem C_triple_defect_proof :
    Ideal.span {iota xa} ⊓ Ideal.span {iota xb} ⊓ Ideal.span {iota (xa + xb)} ≠
      (Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb}).map iota := by
  intro h
  have hmem : (TrivSqZeroExt.inr uElt : Cring) ∈
      Ideal.span {iota xa} ⊓ Ideal.span {iota xb} ⊓ Ideal.span {iota (xa + xb)} :=
    ⟨⟨mem_span_iota_inr M_u_mem_triple_proof.1.1,
      mem_span_iota_inr M_u_mem_triple_proof.1.2⟩,
      mem_span_iota_inr M_u_mem_triple_proof.2⟩
  rw [h, B_triple_inter_eq_bot_proof, Ideal.map_bot, Ideal.mem_bot] at hmem
  exact inr_uElt_ne_zero hmem

/-! ## D3 and D4 — `C` preserves annihilators and pairwise intersections

Both steps are stated with Stage C's frozen theorems 7 (`M_ann_eq`) and 8
(`M_pair_inter`) as explicit hypotheses `hM7` / `hM8`, because they are being
proved in parallel.  Apart from those hypotheses the statements are those of the
frozen theorems 13 and 14. -/

/-- Membership in the module annihilator `annM Mmod x = ker (lsmul x)` is the
equation `x • m = 0`.  The module-side counterpart of Stage A's `mem_ann`. -/
theorem di_mem_annM_iff (x : Balg) (m : Mmod) : m ∈ annM Mmod x ↔ x • m = 0 := by
  rw [annM, LinearMap.mem_ker, LinearMap.lsmul_apply]

/-- **D3 (frozen theorem 13, parametrized).** `C = B ⋉ M` preserves annihilators:
`(0 :_C iota x) = (0 :_B x)·C`, given Stage C's `M_ann_eq` as `hM7`.

An element `c = (z, n)` of `C` satisfies `iota x * c = (x * z, x • n) = 0` iff
`z ∈ ann x` and `n ∈ annM Mmod x`; `hM7` turns the second condition into
`n ∈ (ann x)·M`, and that pair of conditions is exactly `D1`'s description
(`mem_map_iota_iff`) of membership in `(ann x).map iota`. -/
theorem di_ann_eq_of_M (hM7 : ∀ x : Balg, annM Mmod x = smulTop (ann x)) :
    ∀ x : Balg, ann (iota x) = (ann x).map iota := by
  intro x
  ext c
  rw [mem_ann, mem_map_iota_iff]
  have hmul : c * iota x = iota x * c := mul_comm _ _
  rw [hmul, TrivSqZeroExt.ext_iff, iota_mul_fst, iota_mul_snd,
    TrivSqZeroExt.fst_zero, TrivSqZeroExt.snd_zero]
  have hfst : x * c.fst = 0 ↔ c.fst ∈ ann x := by
    rw [mem_ann, mul_comm]
  have hsnd : x • c.snd = 0 ↔ c.snd ∈ (smulTop (ann x) : Submodule Balg Mmod) := by
    rw [← di_mem_annM_iff, hM7 x]
  rw [hfst, hsnd]

/-- **D4 (frozen theorem 14, parametrized).** `C = B ⋉ M` preserves pairwise
principal intersections: `(iota x)·C ∩ (iota y)·C = (xB ∩ yB)·C`, given Stage C's
`M_pair_inter` as `hM8`.

By `D2` the left-hand side is `{(z, n) | z ∈ xB ⊓ yB ∧ n ∈ xM ⊓ yM}`; `hM8`
rewrites the second condition as `n ∈ (xB ⊓ yB)·M`, and `D1` recognises the
result as membership in `(xB ⊓ yB).map iota`. -/
theorem di_pair_inter_of_M
    (hM8 : ∀ x y : Balg, (smulTop (Ideal.span {x}) : Submodule Balg Mmod) ⊓
      smulTop (Ideal.span {y}) = smulTop (Ideal.span {x} ⊓ Ideal.span {y})) :
    ∀ x y : Balg, Ideal.span {iota x} ⊓ Ideal.span {iota y} =
      (Ideal.span {x} ⊓ Ideal.span {y}).map iota := by
  intro x y
  ext c
  rw [Submodule.mem_inf, mem_span_iota_iff, mem_span_iota_iff, mem_map_iota_iff,
    Submodule.mem_inf, ← hM8 x y, Submodule.mem_inf]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    exact ⟨⟨h1, h3⟩, h2, h4⟩
  · rintro ⟨⟨h1, h3⟩, h2, h4⟩
    exact ⟨⟨h1, h2⟩, h3, h4⟩

/-! ## D3 and D4, unconditional

Stage C has landed `M_ann_eq_proof` and `M_pair_inter_proof` (frozen theorems 7
and 8) in `Prob4b/Proofs/StageC_Module/Basic.lean`, which this file already
imports, so the two parametrized results above discharge into the frozen
statements 13 and 14. -/

/-- **D3 (frozen theorem 13).** `C = B ⋉ M` preserves annihilators:
`(0 :_C iota x) = (0 :_B x)·C`.  The instantiation of `di_ann_eq_of_M` at Stage
C's `M_ann_eq_proof`. -/
theorem C_ann_eq_proof : ∀ x : Balg, ann (iota x) = (ann x).map iota :=
  di_ann_eq_of_M M_ann_eq_proof

/-- **D4 (frozen theorem 14).** `C = B ⋉ M` preserves pairwise principal
intersections: `xC ∩ yC = (xB ∩ yB)C`.  The instantiation of
`di_pair_inter_of_M` at Stage C's `M_pair_inter_proof`. -/
theorem C_pair_inter_proof :
    ∀ x y : Balg, Ideal.span {iota x} ⊓ Ideal.span {iota y} =
      (Ideal.span {x} ⊓ Ideal.span {y}).map iota :=
  di_pair_inter_of_M M_pair_inter_proof

/-! ## Guardrails -/

/-- `C` did not collapse. Needs `Nontrivial Balg`, i.e. Stage A's
`B_nontrivial_proof`. -/
example : (1 : Cring) ≠ 0 := by
  haveI := B_nontrivial_proof
  intro h
  have h1 : (1 : Balg) = 0 := by
    have h2 := congrArg TrivSqZeroExt.fst h
    rw [TrivSqZeroExt.fst_one, TrivSqZeroExt.fst_zero] at h2
    exact h2
  exact one_ne_zero h1

/-- Stage D cheat-watch (e): the module side of `C` did not collapse either —
`inr u ≠ 0`. Needs Stage C's `M_u_ne_zero_proof`. -/
example : (TrivSqZeroExt.inr uElt : Cring) ≠ 0 := inr_uElt_ne_zero

