/-!
# Stage F — the triple intersection in `R`, and the headline

Delivers `R_triple_inter_not_fg_proof`, `R_not_quasiCoherent_proof`,
`quasiCoherent_imp_finiteConductor_proof` and
`exists_finiteConductor_not_quasiCoherent_proof`.

Iteration 1 delivered step **F6** only, the dependency-free converse
`quasiCoherent_imp_finiteConductor_proof` (frozen theorem 19), together with its
support lemma `iInf_fin_two`.

Iteration 3 adds steps **F1–F5**:

* `iInf_fin_three` — the `Fin 3` analogue of `iInf_fin_two`;
* `uAt_mem_triple` (F1) — every `uAt n` lies in the triple intersection
  `aR ⊓ bR ⊓ (a+b)R`;
* `uAt_ne_zero` (F2) — and is nonzero;
* `support_of_mem_triple` (F3) — every element of the triple intersection has tail
  value `0`, hence finite support, *because* `B_triple_inter_eq_bot_proof` says the
  corresponding intersection in `B` is `⊥`;
* `R_triple_inter_not_fg_proof` (F4, frozen theorem 17) — a finitely generated ideal is
  supported on the finite union of the exceptional sets of its generators, which cannot
  contain all the `uAt n`;
* `R_not_quasiCoherent_proof` (F5, frozen theorem 18) — the `n = 3` instance of the
  frozen `QuasiCoherent` predicate, closed by F4.

Iteration 5 adds step **F7**, the headline `exists_finiteConductor_not_quasiCoherent_proof`
(frozen theorem 20), now that Stage E has landed `R_finiteConductor_proof`: the witness is
`Ramp` with its canonical `Subring.toCommRing` instance, paired with F5 above. (This
paragraph supersedes the earlier one saying F7 is not attempted here.)

Nothing in this file asserts
or uses Noetherianity or finiteness of `Ramp`: every finiteness statement below comes
from a finite exceptional set.
-/

universe u

namespace Prob4b

/-- An indexed intersection of principal ideals over `Fin 2` is the binary meet
of the two principal ideals: `⨅ i, (![x, y] i) • S = xS ⊓ yS`. -/
theorem iInf_fin_two {S : Type*} [CommRing S] (x y : S) :
    (⨅ i, Ideal.span {![x, y] i} : Ideal S) = Ideal.span {x} ⊓ Ideal.span {y} := by
  refine le_antisymm (le_inf ?_ ?_) (le_iInf fun i => ?_)
  · exact iInf_le (fun i : Fin 2 => Ideal.span {![x, y] i}) 0
  · exact iInf_le (fun i : Fin 2 => Ideal.span {![x, y] i}) 1
  · fin_cases i
    · exact inf_le_left
    · exact inf_le_right

set_option linter.unusedVariables false in
/-- **F6 / frozen theorem 19.** Every quasi-coherent ring is a finite-conductor
ring: the pairwise principal intersections are the `n = 2` instance of the
arbitrary finite ones. -/
theorem quasiCoherent_imp_finiteConductor_proof :
    ∀ {S : Type u} [inst : CommRing S], QuasiCoherent S → FiniteConductor S := by
  intro S inst h
  obtain ⟨h₁, h₂⟩ := h
  refine ⟨h₁, fun x y => ?_⟩
  have h₃ := h₂ 2 ![x, y]
  rwa [iInf_fin_two] at h₃

/-- An indexed intersection of principal ideals over `Fin 3` is the iterated binary meet
`(xS ⊓ yS) ⊓ zS`, with the bracketing of frozen theorem 17. -/
theorem iInf_fin_three {S : Type*} [CommRing S] (x y z : S) :
    (⨅ i, Ideal.span {![x, y, z] i} : Ideal S) =
      Ideal.span {x} ⊓ Ideal.span {y} ⊓ Ideal.span {z} := by
  refine le_antisymm (le_inf (le_inf ?_ ?_) ?_) (le_iInf fun i => ?_)
  · exact iInf_le (fun i : Fin 3 => Ideal.span {![x, y, z] i}) 0
  · exact iInf_le (fun i : Fin 3 => Ideal.span {![x, y, z] i}) 1
  · exact iInf_le (fun i : Fin 3 => Ideal.span {![x, y, z] i}) 2
  · fin_cases i
    · exact inf_le_left.trans inf_le_left
    · exact inf_le_left.trans inf_le_right
    · exact inf_le_right

/-! ### F1 — the defect elements lie in the triple intersection -/

/-- The evaluation of an element of `Ramp` at a coordinate, packaged as a ring
homomorphism so that it commutes with finite sums. -/
noncomputable def hf_evalAt (n : ℕ) : Ramp →+* Cring :=
  (Pi.evalRingHom (fun _ : ℕ => Cring) n).comp Rsub.subtype

/-- `hf_evalAt n` is literally "take the `n`-th coordinate". -/
@[simp] theorem hf_evalAt_apply (n : ℕ) (f : Ramp) :
    hf_evalAt n f = (f : ℕ → Cring) n := rfl

/-- The frozen element `uAt n` is the coordinate element carrying `(0, u)` at `n`. -/
theorem hf_uAt_eq_coordAt (n : ℕ) : uAt n = coordAt n (TrivSqZeroExt.inr uElt) :=
  Subtype.ext rfl

/-- The `n`-th coordinate of `uAt n` is the defect `(0, u) ∈ C`. -/
@[simp] theorem hf_uAt_apply_self (n : ℕ) :
    ((uAt n : Ramp) : ℕ → Cring) n = TrivSqZeroExt.inr uElt := by
  rw [hf_uAt_eq_coordAt]; exact coordAt_apply_self n _

/-- If `u ∈ sM` then the defect `(0, u) ∈ C` lies in the principal ideal generated by
`iota s`: its `fst` component is `0 ∈ sB` and its `snd` component is `u ∈ sM`. -/
theorem hf_inr_mem_span_iota (s : Balg)
    (hs : uElt ∈ (smulTop (Ideal.span {s}) : Submodule Balg Mmod)) :
    (TrivSqZeroExt.inr uElt : Cring) ∈ Ideal.span {iota s} := by
  refine (mem_span_iota_iff s _).2 ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_inr]; exact Submodule.zero_mem _
  · rw [TrivSqZeroExt.snd_inr]; exact hs

/-- If `u ∈ sM` then `uAt n` lies in the principal ideal of `R` generated by `diag s`:
lift a `C`-witness `c` with `c * iota s = (0, u)` to the coordinate element
`coordAt n c`. -/
theorem hf_uAt_mem_span_diag (s : Balg)
    (hs : uElt ∈ (smulTop (Ideal.span {s}) : Submodule Balg Mmod)) (n : ℕ) :
    uAt n ∈ Ideal.span {diag s} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 (hf_inr_mem_span_iota s hs)
  refine Ideal.mem_span_singleton'.2 ⟨coordAt n c, ?_⟩
  rw [coordAt_mul, diag_apply, hc, hf_uAt_eq_coordAt]

/-- **F1.** Every defect element `uAt n` lies in the triple intersection
`aR ⊓ bR ⊓ (a+b)R`. -/
theorem uAt_mem_triple (n : ℕ) :
    uAt n ∈ Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)} := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · exact hf_uAt_mem_span_diag xa M_u_mem_triple_proof.1.1 n
  · exact hf_uAt_mem_span_diag xb M_u_mem_triple_proof.1.2 n
  · exact hf_uAt_mem_span_diag (xa + xb) M_u_mem_triple_proof.2 n

/-! ### F2 — the defect elements are nonzero -/

/-- **F2.** `uAt n ≠ 0`: its `n`-th coordinate is `(0, u)`, and `u ≠ 0` in `M`. -/
theorem uAt_ne_zero (n : ℕ) : uAt n ≠ 0 := by
  intro h
  have hcoord : (TrivSqZeroExt.inr uElt : Cring) = 0 := by
    rw [← hf_uAt_apply_self n, h, coe_zero_apply]
  exact M_u_ne_zero_proof (by simpa using congrArg TrivSqZeroExt.snd hcoord)

/-! ### F3 — every element of the triple intersection has tail value zero -/

/-- The tail value of an element of a principal ideal `sR` lies in the principal ideal
`sB`: `tailValue` is multiplicative and sends `diag s` to `s`. -/
theorem hf_tailValue_mem_of_mem_span (s : Balg) {h : Ramp} (hh : h ∈ Ideal.span {diag s}) :
    tailValue h ∈ Ideal.span {s} := by
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hh
  refine Ideal.mem_span_singleton'.2 ⟨tailValue r, ?_⟩
  rw [← hr, tailValue_mul, tailValue_diag]

/-- **F3.** Every element of the triple intersection `aR ⊓ bR ⊓ (a+b)R` has tail value
`0` — i.e. finite support — because the corresponding triple intersection in `B` is `⊥`
(`B_triple_inter_eq_bot_proof`). -/
theorem support_of_mem_triple (h : Ramp)
    (hh : h ∈ Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)}) : tailValue h = 0 := by
  have hmem : tailValue h ∈ Ideal.span {xa} ⊓ Ideal.span {xb} ⊓ Ideal.span {xa + xb} :=
    ⟨⟨hf_tailValue_mem_of_mem_span xa hh.1.1, hf_tailValue_mem_of_mem_span xb hh.1.2⟩,
      hf_tailValue_mem_of_mem_span (xa + xb) hh.2⟩
  rw [B_triple_inter_eq_bot_proof] at hmem
  exact hmem

/-- Off its exceptional set, an element of the triple intersection vanishes outright:
its tail value is `0` by F3. -/
theorem hf_apply_eq_zero_of_mem_triple (h : Ramp)
    (hh : h ∈ Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)}) {n : ℕ} (hn : n ∉ exc h) :
    (h : ℕ → Cring) n = 0 := by
  rw [apply_eq_of_not_mem_exc h n hn, support_of_mem_triple h hh, map_zero]

/-! ### F4 — the triple intersection is not finitely generated -/

/-- **F4 / frozen theorem 17.** The triple intersection `aR ⊓ bR ⊓ (a+b)R` is not
finitely generated: a finite generating set is supported on the finite union `T` of the
exceptional sets of its generators, so every element of the ideal vanishes outside `T`,
whereas `uAt n` for `n ∉ T` lies in the ideal and does not vanish at `n`. -/
theorem R_triple_inter_not_fg_proof :
    ¬ (Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
      Ideal.span {diag (xa + xb)} : Ideal Ramp).FG := by
  rintro ⟨s, hs⟩
  -- the finite union of the exceptional sets of the generators
  set T : Set ℕ := ⋃ i ∈ (s : Set Ramp), exc i with hT
  have hTfin : T.Finite := s.finite_toSet.biUnion fun i _ => exc_finite i
  obtain ⟨n, hn⟩ := hTfin.infinite_compl.nonempty
  -- every generator lies in the triple intersection, hence vanishes at `n`
  have hgen : ∀ i ∈ s, (i : ℕ → Cring) n = 0 := by
    intro i hi
    have hiJ : i ∈ Ideal.span {diag xa} ⊓ Ideal.span {diag xb} ⊓
        Ideal.span {diag (xa + xb)} := by
      rw [← hs]; exact Ideal.subset_span (Finset.mem_coe.2 hi)
    refine hf_apply_eq_zero_of_mem_triple i hiJ (fun hmem => hn ?_)
    exact hT ▸ Set.mem_biUnion (Finset.mem_coe.2 hi) hmem
  -- but `uAt n` is in the ideal and does not vanish at `n`
  have huA : uAt n ∈ Ideal.span (↑s : Set Ramp) := by rw [hs]; exact uAt_mem_triple n
  obtain ⟨g, hg⟩ := (mem_ideal_span_finset s (uAt n)).1 huA
  have hzero : ((uAt n : Ramp) : ℕ → Cring) n = 0 := by
    have hval : hf_evalAt n (uAt n) = ∑ i ∈ s, hf_evalAt n (g i) * hf_evalAt n i := by
      rw [hg, map_sum]
      exact Finset.sum_congr rfl fun i _ => map_mul _ _ _
    have : hf_evalAt n (uAt n) = 0 := by
      rw [hval]
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [hf_evalAt_apply n i, hgen i hi, mul_zero]
    simpa using this
  rw [hf_uAt_apply_self n] at hzero
  exact M_u_ne_zero_proof (by simpa using congrArg TrivSqZeroExt.snd hzero)

/-! ### F5 — `R` is not quasi-coherent -/

/-- **F5 / frozen theorem 18.** `R` is not quasi-coherent: the frozen predicate
quantifies over every `n` and every family `f : Fin n → R`, and its `n = 3` instance at
`![diag xa, diag xb, diag (xa + xb)]` is refuted by F4. -/
theorem R_not_quasiCoherent_proof : ¬ QuasiCoherent Ramp := by
  rintro ⟨h₁, h₂⟩
  have h₃ := h₂ 3 ![diag xa, diag xb, diag (xa + xb)]
  rw [iInf_fin_three] at h₃
  exact R_triple_inter_not_fg_proof h₃

/-! ### F7 — the headline -/

/-- **F7 / frozen theorem 20.** HEADLINE: there is a finite-conductor ring that is not
quasi-coherent.  The witness is `R = Δ(B) + C^(ℕ)` with its canonical `CommRing`
instance (`Subring.toCommRing`, supplied by `inferInstance`), which is a finite-conductor
ring by Stage E's `R_finiteConductor_proof` and fails quasi-coherence by F5. -/
theorem exists_finiteConductor_not_quasiCoherent_proof :
    ∃ (S : Type) (inst : CommRing S), @FiniteConductor S inst ∧ ¬ @QuasiCoherent S inst :=
  ⟨Ramp, inferInstance, R_finiteConductor_proof, R_not_quasiCoherent_proof⟩

end Prob4b
