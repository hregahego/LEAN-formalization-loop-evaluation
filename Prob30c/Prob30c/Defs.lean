/-
Problem 30(c) — polynomial extension can raise the absorbing number.

FROZEN FILE.  Every object the proof needs is defined here, in dependency order,
together with the modeling decision that fixes it.  After SETUP this file is
never edited again: it is byte-pinned in `scripts/frozen.sha256`.

`USER_NOTES.md` permits **no** assumed certificates, so this file contains no
`axiom` declaration, and `scripts/ALLOWED_AXIOMS.txt` is empty.
-/
import Mathlib

namespace Prob30c

open Polynomial Finset

/-! ## D1 — the Anderson–Badawi `n`-absorbing predicate -/

/-- `I` is `n`-absorbing: whenever a product of `n+1` elements lies in `I`,
    already `n` of the factors have their product in `I`. -/
def IsNAbsorbing {R : Type*} [CommRing R] (I : Ideal R) (n : ℕ) : Prop :=
  ∀ a : Fin (n + 1) → R, (∏ i, a i) ∈ I →
    ∃ S : Finset (Fin (n + 1)), S.card = n ∧ (∏ i ∈ S, a i) ∈ I

/-! ## D2 — the absorbing number `ω_R(I)` -/

/-- `ω_R(I)`: the least positive `n` for which `I` is `n`-absorbing (`0` if none). -/
noncomputable def omegaAbs {R : Type*} [CommRing R] (I : Ideal R) : ℕ :=
  sInf {n : ℕ | 0 < n ∧ IsNAbsorbing I n}

/-! ## D3 — the ideal `I[X]` -/

/-- `I[X] ⊆ R[X]`, modelled as the ideal generated by the constants from `I`. -/
noncomputable def polyExt {R : Type*} [CommRing R] (I : Ideal R) : Ideal (Polynomial R) :=
  I.map (Polynomial.C : R →+* Polynomial R)

/-! ## D4 — Problem 30(c) itself -/

/-- Anderson–Badawi Conjecture C2 / Problem 30(c): `ω_{R[X]}(I[X]) = ω_R(I)`. -/
def PolyAbsorbingConj : Prop :=
  ∀ (R : Type) [CommRing R] (I : Ideal R), omegaAbs (polyExt I) = omegaAbs I

/-! ## D5 — the base ring `D = 𝔽₂[t]` -/

abbrev F2 : Type := ZMod 2
abbrev Dbase : Type := Polynomial F2
/-- The variable `t` of `D = 𝔽₂[t]` (kept separate from the `X` of `A_q[X]`). -/
noncomputable abbrev tD : Dbase := Polynomial.X

/-! ## D6 — the torsion coefficient ring `B/τ^q` -/

/-- `B ⧸ (τ^q)`; for `B = D`, `τ = t` this is the `D/t^qD` of the sketch. -/
abbrev Quo (B : Type) [CommRing B] (τ : B) (q : ℕ) : Type :=
  B ⧸ Ideal.span {τ ^ q}

/-! ## D7 — the augmentation module `Jmod` with its multiplication -/

/-- Coordinates `(a₁, a₂, a₃, c₁, c₂, σ)` of `a₁e₁ + a₂e₂ + a₃e₃ + c₁u₁ + c₂u₂ + σs`. -/
def Jmod (B : Type) [CommRing B] (τ : B) (q : ℕ) : Type :=
  B × B × B × B × B × Quo B τ q

instance (B) [CommRing B] (τ : B) (q : ℕ) : AddCommGroup (Jmod B τ q) :=
  inferInstanceAs (AddCommGroup (B × B × B × B × B × Quo B τ q))
instance (B) [CommRing B] (τ : B) (q : ℕ) : Module B (Jmod B τ q) :=
  inferInstanceAs (Module B (B × B × B × B × B × Quo B τ q))

/-- The multiplication table `e₁e₃ = u₂+s`, `e₂² = u₂`, `e₂e₃ = e₃² = u₁`,
    all other `eᵢeⱼ = 0`, and `u₁, u₂, s` annihilate `J`. -/
instance (B) [CommRing B] (τ : B) (q : ℕ) : Mul (Jmod B τ q) :=
  ⟨fun x y =>
    (0, 0, 0,
     x.2.1 * y.2.2.1 + x.2.2.1 * y.2.1 + x.2.2.1 * y.2.2.1,   -- u₁ : a₂b₃ + a₃b₂ + a₃b₃
     x.1 * y.2.2.1 + x.2.2.1 * y.1 + x.2.1 * y.2.1,           -- u₂ : a₁b₃ + a₃b₁ + a₂b₂
     Ideal.Quotient.mk _ (x.1 * y.2.2.1 + x.2.2.1 * y.1))⟩    -- s  : a₁b₃ + a₃b₁

namespace Jmod

variable {B : Type} [CommRing B] {τ : B} {q : ℕ}

/-- `B` acts on the `s`-coordinate by multiplication on any lift. -/
theorem quo_smul_mk (b z : B) :
    b • (Ideal.Quotient.mk (Ideal.span {τ ^ q}) z : Quo B τ q)
      = Ideal.Quotient.mk (Ideal.span {τ ^ q}) (b * z) := rfl

/-- The six coordinates of `0`. -/
theorem zero_def : (0 : Jmod B τ q) = ((0, 0, 0, 0, 0, 0) : Jmod B τ q) := rfl

/-- Addition is coordinatewise. -/
theorem add_def (x y : Jmod B τ q) :
    x + y =
      ((x.1 + y.1, x.2.1 + y.2.1, x.2.2.1 + y.2.2.1,
        x.2.2.2.1 + y.2.2.2.1, x.2.2.2.2.1 + y.2.2.2.2.1,
        x.2.2.2.2.2 + y.2.2.2.2.2) : Jmod B τ q) := rfl

/-- Negation is coordinatewise. -/
theorem neg_def (x : Jmod B τ q) :
    -x = ((-x.1, -x.2.1, -x.2.2.1, -x.2.2.2.1, -x.2.2.2.2.1, -x.2.2.2.2.2) :
      Jmod B τ q) := rfl

/-- Scalar multiplication is coordinatewise. -/
theorem smul_def (b : B) (x : Jmod B τ q) :
    b • x =
      ((b • x.1, b • x.2.1, b • x.2.2.1, b • x.2.2.2.1, b • x.2.2.2.2.1,
        b • x.2.2.2.2.2) : Jmod B τ q) := rfl

/-- The multiplication table, written out on coordinates. -/
theorem mul_def (x y : Jmod B τ q) :
    x * y =
      ((0, 0, 0,
        x.2.1 * y.2.2.1 + x.2.2.1 * y.2.1 + x.2.2.1 * y.2.2.1,
        x.1 * y.2.2.1 + x.2.2.1 * y.1 + x.2.1 * y.2.1,
        Ideal.Quotient.mk (Ideal.span {τ ^ q}) (x.1 * y.2.2.1 + x.2.2.1 * y.1)) :
        Jmod B τ q) := rfl

/-- Coordinatewise extensionality for `Jmod`. -/
theorem ext' {x y : Jmod B τ q}
    (h₁ : x.1 = y.1) (h₂ : x.2.1 = y.2.1) (h₃ : x.2.2.1 = y.2.2.1)
    (h₄ : x.2.2.2.1 = y.2.2.2.1) (h₅ : x.2.2.2.2.1 = y.2.2.2.2.1)
    (h₆ : x.2.2.2.2.2 = y.2.2.2.2.2) : x = y :=
  Prod.ext h₁ (Prod.ext h₂ (Prod.ext h₃ (Prod.ext h₄ (Prod.ext h₅ h₆))))

end Jmod

/-- The uniform closing tactic for every field of the algebraic instances below:
    split into the six coordinates, reduce the projections, push `Ideal.Quotient.mk`
    through the ring operations, and finish with `ring` in `B` or in `Quo B τ q`. -/
local macro "jmod_coords" : tactic =>
  `(tactic| (refine Jmod.ext' ?_ ?_ ?_ ?_ ?_ ?_ <;>
      (try dsimp only) <;>
      (try simp only [smul_add, ← smul_mul_assoc, Jmod.quo_smul_mk, smul_eq_mul,
        map_add, map_mul, map_zero]) <;>
      ring))

instance (B : Type) [CommRing B] (τ : B) (q : ℕ) : NonUnitalCommRing (Jmod B τ q) :=
  { (inferInstance : AddCommGroup (Jmod B τ q)) with
    mul := (· * ·)
    left_distrib := by
      intro a b c; simp only [Jmod.mul_def, Jmod.add_def]; jmod_coords
    right_distrib := by
      intro a b c; simp only [Jmod.mul_def, Jmod.add_def]; jmod_coords
    zero_mul := by
      intro a; simp only [Jmod.mul_def, Jmod.zero_def]; jmod_coords
    mul_zero := by
      intro a; simp only [Jmod.mul_def, Jmod.zero_def]; jmod_coords
    mul_assoc := by
      intro a b c; simp only [Jmod.mul_def]; jmod_coords
    mul_comm := by
      intro a b; simp only [Jmod.mul_def]; jmod_coords }

instance (B : Type) [CommRing B] (τ : B) (q : ℕ) :
    IsScalarTower B (Jmod B τ q) (Jmod B τ q) where
  smul_assoc b x y := by
    show (b • x) * y = b • (x * y)
    simp only [Jmod.mul_def, Jmod.smul_def]; jmod_coords

instance (B : Type) [CommRing B] (τ : B) (q : ℕ) :
    SMulCommClass B (Jmod B τ q) (Jmod B τ q) where
  smul_comm b x y := by
    show b • (x * y) = x * (b • y)
    simp only [Jmod.mul_def, Jmod.smul_def]; jmod_coords

/-! ## D8 — the ring `A(B, τ, q)` and the counterexample `A q` -/

/-- `B ⋉ Jmod B τ q`: the sketch's `A_q` over a general base. -/
abbrev Alg (B : Type) [CommRing B] (τ : B) (q : ℕ) : Type := Unitization B (Jmod B τ q)

/-- The counterexample ring `A_q = D1 ⊕ De₁ ⊕ De₂ ⊕ De₃ ⊕ Du₁ ⊕ Du₂ ⊕ (D/t^q)s`. -/
abbrev A (q : ℕ) : Type := Alg Dbase tD q

/-! ## D9 — the generators -/

namespace Alg
variable (B : Type) [CommRing B] (τ : B) (q : ℕ)

def e₁ : Alg B τ q := Unitization.inr (1, 0, 0, 0, 0, 0)
def e₂ : Alg B τ q := Unitization.inr (0, 1, 0, 0, 0, 0)
def e₃ : Alg B τ q := Unitization.inr (0, 0, 1, 0, 0, 0)
def u₁ : Alg B τ q := Unitization.inr (0, 0, 0, 1, 0, 0)
def u₂ : Alg B τ q := Unitization.inr (0, 0, 0, 0, 1, 0)
def sElt : Alg B τ q := Unitization.inr (0, 0, 0, 0, 0, Ideal.Quotient.mk _ 1)
def tElt : Alg B τ q := algebraMap B (Alg B τ q) τ
end Alg

noncomputable abbrev e₁ (q : ℕ) : A q := Alg.e₁ Dbase tD q
noncomputable abbrev e₂ (q : ℕ) : A q := Alg.e₂ Dbase tD q
noncomputable abbrev e₃ (q : ℕ) : A q := Alg.e₃ Dbase tD q
noncomputable abbrev u₁ (q : ℕ) : A q := Alg.u₁ Dbase tD q
noncomputable abbrev u₂ (q : ℕ) : A q := Alg.u₂ Dbase tD q
noncomputable abbrev sElt (q : ℕ) : A q := Alg.sElt Dbase tD q
noncomputable abbrev tElt (q : ℕ) : A q := Alg.tElt Dbase tD q

/-! ## D10 — the ideals `J` and `W` -/

/-- `J`: the augmentation ideal, i.e. the kernel of `A → B`. -/
def Jid (B : Type) [CommRing B] (τ : B) (q : ℕ) : Ideal (Alg B τ q) :=
  RingHom.ker (Unitization.fstHom B (Jmod B τ q) : Alg B τ q →+* B)

/-- `W = Du₁ + Du₂ + (D/t^q)s`. -/
def Wid (B : Type) [CommRing B] (τ : B) (q : ℕ) : Ideal (Alg B τ q) :=
  Ideal.span {Alg.u₁ B τ q, Alg.u₂ B τ q, Alg.sElt B τ q}

/-! ## D11 — the two polynomials of Step 4 -/

/-- `f = e₂ + X e₃ ∈ A_q[X]`. -/
noncomputable def fPoly (q : ℕ) : Polynomial (A q) := C (e₂ q) + C (e₃ q) * X
/-- `g = (1+X)e₁ + (X+X²)e₂ + X² e₃ ∈ A_q[X]`. -/
noncomputable def gPoly (q : ℕ) : Polynomial (A q) :=
  C (e₁ q) * (1 + X) + C (e₂ q) * (X + X ^ 2) + C (e₃ q) * X ^ 2

end Prob30c
